# Bore & Barrel — Environment Variables
# Salin file ini menjadi .env lalu isi dengan project Supabase MILIK SENDIRI
# (Supabase Dashboard → Project Settings → API). Jangan memakai URL/key bersama dari modul.

# Project URL, contoh: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# anon / publishable key project tsb (aman untuk frontend; RLS yang melindungi data)
VITE_SUPABASE_PUBLISHABLE_KEY=
